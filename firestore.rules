rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName']) &&
        data.keys().hasOnly(['uid', 'displayName', 'skin', 'playerScale', 'blueScaleX', 'blueScaleY', 'orangeScaleX', 'orangeScaleY', 'teleportsCount', 'propsSpawned', 'updatedAt']) &&
        data.uid is string && data.uid == userId && data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 64 &&
        (!('skin' in data) || (data.skin is string && data.skin.size() <= 65536)) &&
        (!('playerScale' in data) || (data.playerScale is number && data.playerScale >= 0.2 && data.playerScale <= 5.0)) &&
        (!('blueScaleX' in data) || (data.blueScaleX is number && data.blueScaleX >= 0.2 && data.blueScaleX <= 5.0)) &&
        (!('blueScaleY' in data) || (data.blueScaleY is number && data.blueScaleY >= 0.2 && data.blueScaleY <= 5.0)) &&
        (!('orangeScaleX' in data) || (data.orangeScaleX is number && data.orangeScaleX >= 0.2 && data.orangeScaleX <= 5.0)) &&
        (!('orangeScaleY' in data) || (data.orangeScaleY is number && data.orangeScaleY >= 0.2 && data.orangeScaleY <= 5.0)) &&
        (!('teleportsCount' in data) || data.teleportsCount is number) &&
        (!('propsSpawned' in data) || data.propsSpawned is number) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data, userId);
      allow delete: if isOwner(userId);
    }
  }
}
